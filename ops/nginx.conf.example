# nginx in front of Streamer Wands, for the production deployment. Host name and port come from
# ops/deployments/production.sh.
#
# TLS is in the shape `certbot --nginx` writes. On a host without a certificate yet, replace
# the HTTPS block's listen and certificate lines with `listen 80; listen [::]:80;`, leave out
# the redirect block, and run `sudo certbot --nginx -d onlywands.com`, which puts them back.
#
# Self-contained, so each deployment on a host has a file of its own. For another deployment,
# copy it and change the host name, the port, the cache and log paths, and the `onlywands_`
# prefix of every zone, variable and log format (e.g. to `onlywands_dev_`).
#
# All requests, websockets included, go to the container. nginx serves nothing from disk.

# Cache for /static/. Entries follow the server's Cache-Control headers.
proxy_cache_path /var/cache/nginx/onlywands levels=1:2 keys_zone=onlywands_cache:10m
                 max_size=200m inactive=30d;

# Per-address limits. The server has none of its own.
#   conn: connections open at once, websockets included
#   req:  request rate, websocket opens included
# Untested starting values. Several viewers can share one address.
limit_conn_zone $binary_remote_addr zone=onlywands_conn:10m;
limit_req_zone  $binary_remote_addr zone=onlywands_req:10m rate=10r/s;

# Websocket upgrades.
map $http_upgrade $onlywands_connection_upgrade {
    default upgrade;
    ''      close;
}

# Access log without mod tokens. A mod connects to /<token> (or //<token>), and the token is a
# JWT that does not expire, so the logged path replaces it. nginx's error log cannot be filtered
# this way and still records the full path of a request that fails, such as one the container
# did not answer.
map $request_uri $onlywands_logged_uri {
    "~^/+[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$"  /<token>;
    default                                                  $request_uri;
}
log_format onlywands_log '$remote_addr - $remote_user [$time_local] '
                         '"$request_method $onlywands_logged_uri $server_protocol" $status '
                         '$body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name onlywands.com;                  # host of PUBLIC_URL

    ssl_certificate /etc/letsencrypt/live/onlywands.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/onlywands.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/onlywands.access.log onlywands_log;
    error_log  /var/log/nginx/onlywands.error.log;

    # Matches the server's limit on the download form, which carries the stats file.
    client_max_body_size 4m;

    location /static/ {
        proxy_pass http://127.0.0.1:2234;       # HOST_PORT
        proxy_set_header Host $host;
        proxy_cache onlywands_cache;
        proxy_cache_lock on;
        # Keep serving cached files while the server is down or restarting.
        proxy_cache_use_stale error timeout updating http_502 http_503 http_504;
    }

    location / {
        limit_conn onlywands_conn 20;
        limit_req zone=onlywands_req burst=40 nodelay;

        proxy_pass http://127.0.0.1:2234;       # HOST_PORT
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $onlywands_connection_upgrade;
        # Long-lived websockets. Must exceed the server's ping interval.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}

server {
    if ($host = onlywands.com) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name onlywands.com;

    access_log /var/log/nginx/onlywands.access.log onlywands_log;
    error_log  /var/log/nginx/onlywands.error.log;

    return 404;
}
