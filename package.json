{
    "name": "streamer-wands",
    "version": "1.2.13",
    "modVersion": "1.2.10",
    "private": true,
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "start": "node server/main.ts",
        "dev": "node --watch server/main.ts",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "release": "node scripts/pack-mod.ts",
        "test": "vitest run --exclude '**/*.integration.test.ts'",
        "test:watch": "vitest --exclude '**/*.integration.test.ts'",
        "test:integration": "vitest run .integration.test.ts",
        "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p test/web",
        "format": "prettier --write ."
    },
    "dependencies": {
        "fast-xml-parser": "^5.2.5",
        "jsonwebtoken": "^9.0.2",
        "jszip": "^3.10.2",
        "semver": "^7.8.5",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@floating-ui/dom": "^1.8.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.0.0",
        "@types/semver": "^7.8.0",
        "@types/ws": "^8.18.1",
        "dotenv": "^16.6.1",
        "mongodb": "^5.9.2",
        "playwright": "^1.63.0",
        "preact": "^11.0.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    }
}
